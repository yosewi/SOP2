#define _GNU_SOURCE
#include <unistd.h>
#include <sys/mman.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <pthread.h>
#include <fcntl.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <time.h>
#include <semaphore.h> // Zmiana: Biblioteka dla semaforów

#define UNUSED(x) ((void)(x))
#define ERR(source) (fprintf(stderr, "%s:%d\n", __FILE__, __LINE__), perror(source), kill(0, SIGKILL), exit(EXIT_FAILURE))

#define MIN_N 2
#define MAX_N 5
#define MIN_M 5
#define MAX_M 10
#define RESIGN_PROBABILITY 5
#define PLAYING 0
#define RESIGNED 1
#define INVALID_CARD -1
#define PERM 0666
#define SHM_NAME "/sop-cards-sem"

typedef struct player_data {
    int card;
    int score;
    int active;
} player_data_t;

// Zmiana: Zamiast barier mamy 4 semafory i jeden mutex
typedef struct shared_data {
    sem_t sem_round_start;   // Serwer ogłasza start rundy
    sem_t sem_cards_ready;   // Gracze zgłaszają wyłożenie kart
    sem_t sem_results_ready; // Serwer zgłasza, że policzył punkty
    sem_t sem_players_done;  // Gracze zgłaszają, że podjęli decyzję o grze
    
    pthread_mutex_t mx_active; // Chroni licznik 'active_players'
    int n;
    int active_players;
    
    player_data_t player_data[];
} shared_data_t;

void usage(char *name) {
    fprintf(stderr, "USAGE: %s N M\n", name);
    fprintf(stderr, "%d <= N <= %d, %d <= M <= %d\n", MIN_N, MAX_N, MIN_M, MAX_M);
    exit(EXIT_FAILURE);
}

int should_resign(int probability) {
    return rand() % probability == 0;
}

int draw_card(int *cards, int *last) {
    if (*last < 0) ERR("draw_card");
    int card_idx = rand() % (*last + 1);
    int drawn = cards[card_idx];
    for (int i = card_idx; i < *last; i++) {
        cards[i] = cards[i + 1];
    }
    cards[(*last)--] = drawn;
    return drawn;
}

void create_cards(int *cards, int m) {
    for (int i = 0; i < m; i++) cards[i] = i + 1;
}

void player_work(shared_data_t *shm_ptr, int id, int m) {
    srand(time(NULL) ^ (getpid() << 16)); 
    int drawn, last = m - 1, last_score = 0;

    fprintf(stdout, "Player [%d]: Joined the game!\n", id);
    int cards[m];
    create_cards(cards, m);

    for (int i = 1; i <= m; i++) {
        // 1. Czekamy na sygnał od serwera, że można losować (zastępuje begin_barrier)
        sem_wait(&shm_ptr->sem_round_start);

        drawn = draw_card(cards, &last);
        shm_ptr->player_data[id].card = drawn;
        fprintf(stdout, "Player [%d]: Drawing card %d in round %d!\n", id, drawn, i);

        // 2. Mówimy serwerowi: "Zrobiłem to, karta leży na stole!"
        sem_post(&shm_ptr->sem_cards_ready);

        // 3. Czekamy na sygnał od serwera, że policzył wyniki (zastępuje game_barrier)
        sem_wait(&shm_ptr->sem_results_ready);

        fprintf(stdout, "Player [%d]: Scoring %d in round %d!\n", id, shm_ptr->player_data[id].score - last_score, i);
        last_score = shm_ptr->player_data[id].score;
        
        // Decyzja o rezygnacji
        shm_ptr->player_data[id].active = should_resign(RESIGN_PROBABILITY);

        if (shm_ptr->player_data[id].active == RESIGNED) {
            fprintf(stdout, "Player [%d]: Leaving the game in round %d!\n", id, i);
            
            // Rezygnacja: Bezpiecznie zmniejszamy globalny licznik graczy
            pthread_mutex_lock(&shm_ptr->mx_active);
            shm_ptr->active_players--;
            pthread_mutex_unlock(&shm_ptr->mx_active);
            
            // Ważne: Musimy podnieść semafor, by serwer nie czekał na nas w tej rundzie!
            sem_post(&shm_ptr->sem_players_done);
            break;
        }

        // 4. Gra toczy się dalej: Mówimy serwerowi, że przetworzyliśmy wyniki
        sem_post(&shm_ptr->sem_players_done);
    }
    
    if (munmap(shm_ptr, sizeof(player_data_t) * shm_ptr->n + sizeof(shared_data_t)) == -1) ERR("munmap");
}

void game_server_work(shared_data_t *shm_ptr, int m) {
    int n = shm_ptr->n;
    fprintf(stdout, "Server: The game has started!\n");

    for (int i = 1; i <= m; i++) {
        // Sprawdzamy ilu graczy zostało przy użyciu mutexa
        pthread_mutex_lock(&shm_ptr->mx_active);
        int current_active = shm_ptr->active_players;
        pthread_mutex_unlock(&shm_ptr->mx_active);

        if (current_active == 0) {
            fprintf(stdout, "Server: No more active players. Ending game.\n");
            break;
        }

        fprintf(stdout, "Server: Round %d! (%d active players)\n", i, current_active);

        // 1. Serwer pociąga za sznurek X razy: budzi wszystkich żywych graczy
        for (int k = 0; k < current_active; k++) sem_post(&shm_ptr->sem_round_start);

        // 2. Serwer czeka X razy: zasypia dopóki wszyscy żywi nie położą kart
        for (int k = 0; k < current_active; k++) sem_wait(&shm_ptr->sem_cards_ready);

        // Obliczanie wyników
        int winning_card = -1, winning_count = 0;
        for (int j = 0; j < n; j++) {
            if (shm_ptr->player_data[j].active == RESIGNED) continue;
            fprintf(stdout, "Server: Player %d has drawn %d!\n", j, shm_ptr->player_data[j].card);

            if (shm_ptr->player_data[j].card > winning_card) {
                winning_card = shm_ptr->player_data[j].card;
                winning_count = 1;
            } else if (shm_ptr->player_data[j].card == winning_card) {
                winning_count++;
            }
        }

        fprintf(stdout, "Server: %d is the winning_card!\n", winning_card);
        fprintf(stdout, "Server: There are %d winners this round!\n", winning_count);

        if (winning_count > 0) {
            int winning_score = current_active / winning_count; // Punktacja dostosowana do obecnych w grze
            for (int j = 0; j < n; j++) {
                if (shm_ptr->player_data[j].active == PLAYING && shm_ptr->player_data[j].card == winning_card) {
                    shm_ptr->player_data[j].score += winning_score;
                }
            }
        }

        // 3. Serwer ogłasza wyniki X razy
        for (int k = 0; k < current_active; k++) sem_post(&shm_ptr->sem_results_ready);

        // 4. Serwer czeka X razy na zakończenie tur przez graczy
        for (int k = 0; k < current_active; k++) sem_wait(&shm_ptr->sem_players_done);
    }

    fprintf(stdout, "Server: It's time to summarise the game!\n");
    for (int i = 0; i < n; i++) {
        fprintf(stdout, "\tPlayer %d: %d points\n", i, shm_ptr->player_data[i].score);
    }
}

int main(int argc, char **argv) {
    if (argc != 3) usage(argv[0]);
    int n = atoi(argv[1]);
    int m = atoi(argv[2]);

    if (n < MIN_N || n > MAX_N || m < MIN_M || m > MAX_M) usage(argv[0]);

    int shm_fd;
    if ((shm_fd = shm_open(SHM_NAME, O_CREAT | O_EXCL | O_RDWR, PERM)) == -1) ERR("shm_open");
    if (ftruncate(shm_fd, sizeof(shared_data_t) + n * sizeof(player_data_t)) == -1) ERR("ftruncate");

    shared_data_t *shm_ptr;
    if ((shm_ptr = mmap(NULL, sizeof(shared_data_t) + n * sizeof(player_data_t), PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0)) == MAP_FAILED) ERR("mmap");
    memset(shm_ptr, 0, sizeof(shared_data_t) + n * sizeof(player_data_t));

    // Zmiana: Inicjalizacja 4 semaforów jako PTHREAD_PROCESS_SHARED (drugi argument = 1)
    // Trzeci argument to początkowa wartość semafora (0 = zamknięte)
    sem_init(&shm_ptr->sem_round_start, 1, 0);
    sem_init(&shm_ptr->sem_cards_ready, 1, 0);
    sem_init(&shm_ptr->sem_results_ready, 1, 0);
    sem_init(&shm_ptr->sem_players_done, 1, 0);

    // Inicjalizacja współdzielonego mutexa
    pthread_mutexattr_t attr;
    pthread_mutexattr_init(&attr);
    pthread_mutexattr_setpshared(&attr, PTHREAD_PROCESS_SHARED);
    pthread_mutex_init(&shm_ptr->mx_active, &attr);
    pthread_mutexattr_destroy(&attr);

    shm_ptr->n = n;
    shm_ptr->active_players = n; // Zapisujemy początkową liczbę żywych graczy

    for (int i = 0; i < n; i++) {
        switch (fork()) {
            case 0:
                player_work(shm_ptr, i, m);
                exit(EXIT_SUCCESS);
            case -1:
                ERR("fork");
        }
    }

    game_server_work(shm_ptr, m);

    while (wait(NULL) > 0);

    // Sprzątanie po serwerze
    sem_destroy(&shm_ptr->sem_round_start);
    sem_destroy(&shm_ptr->sem_cards_ready);
    sem_destroy(&shm_ptr->sem_results_ready);
    sem_destroy(&shm_ptr->sem_players_done);
    pthread_mutex_destroy(&shm_ptr->mx_active);

    munmap(shm_ptr, sizeof(shared_data_t) + n * sizeof(player_data_t));
    shm_unlink(SHM_NAME);

    return EXIT_SUCCESS;
}